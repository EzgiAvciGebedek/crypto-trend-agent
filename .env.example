# Anthropic Claude API
ANTHROPIC_API_KEY=
# Opsiyonel: model ve effort (varsayılan claude-opus-5 / low). Maliyet için claude-sonnet-5
# veya claude-haiku-4-5 kullanılabilir.
ANTHROPIC_MODEL=
ANTHROPIC_EFFORT=

# Reddit (opsiyonel ama önerilir) — kimliksiz JSON artık 403 veriyor.
# https://www.reddit.com/prefs/apps → "script" app oluştur.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cron endpoint koruması — /api/cron/daily çağrılarında Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# CoinGecko demo/pro key (opsiyonel — boş bırakılırsa public rate limit'le çalışır)
COINGECKO_API_KEY=
