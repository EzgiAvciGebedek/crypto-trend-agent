# Anthropic Claude API
ANTHROPIC_API_KEY=
# Optional: model and effort (defaults: claude-opus-5 / low). For cost, use
# claude-sonnet-5 or claude-haiku-4-5.
ANTHROPIC_MODEL=
ANTHROPIC_EFFORT=

# Reddit (optional but recommended) — unauthenticated JSON now returns 403.
# https://www.reddit.com/prefs/apps → create a "script" app.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cron endpoint protection — Authorization: Bearer <CRON_SECRET> on /api/cron/daily calls
CRON_SECRET=

# CoinGecko demo/pro key (optional — falls back to the public rate limit if empty)
COINGECKO_API_KEY=

# CoinMarketCap (optional second "trending" signal). Unlike CoinGecko, CMC has no keyless
# endpoint — without a key this source is simply skipped (graceful degradation).
# Free key: https://coinmarketcap.com/api/
COINMARKETCAP_API_KEY=

# Competitor Radar render/anti-bot proxy (optional). Without a key, the crawler uses
# direct fetches only and Cloudflare-blocked / JS-rendered competitor sites show
# "no content". With a key, those sites are fetched through the proxy (rendered HTML).
# SCRAPER_PROVIDER: "scrapingbee" (default) or "scraperapi".
SCRAPER_API_KEY=
SCRAPER_PROVIDER=
